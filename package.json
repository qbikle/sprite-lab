{
  "name": "sprite-lab",
  "private": true,
  "version": "2.0.0-wave1",
  "type": "module",
  "description": "sprite-lab — cozy-retro professional pixel-art & animation editor",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
